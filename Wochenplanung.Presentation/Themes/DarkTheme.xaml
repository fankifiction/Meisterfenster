<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Werkstatt modern – Dark -->
    <Color x:Key="PrimaryColor">#5B8FBF</Color>
    <Color x:Key="PrimaryHoverColor">#6FA0CC</Color>
    <Color x:Key="BackgroundColor">#1A1D22</Color>
    <Color x:Key="SurfaceColor">#242830</Color>
    <Color x:Key="HeaderColor">#2C313A</Color>
    <Color x:Key="TextPrimaryColor">#F0F3F7</Color>
    <Color x:Key="TextSecondaryColor">#A8B3C0</Color>
    <Color x:Key="BorderColor">#3E4654</Color>
    <Color x:Key="AccentLightColor">#334155</Color>
    <Color x:Key="BandAColor">#242830</Color>
    <Color x:Key="BandBColor">#2A303A</Color>
    <Color x:Key="NameBandAColor">#303848</Color>
    <Color x:Key="NameBandBColor">#353E4C</Color>
    <Color x:Key="AccentStripeAColor">#5B8FBF</Color>
    <Color x:Key="AccentStripeBColor">#7A90A8</Color>
    <Color x:Key="EmployeeOutlineColor">#6B7C92</Color>
    <Color x:Key="TaskChipTextColor">#1A2332</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="BandBrushA" Color="{StaticResource BandAColor}"/>
    <SolidColorBrush x:Key="BandBrushB" Color="{StaticResource BandBColor}"/>
    <SolidColorBrush x:Key="NameBandBrushA" Color="{StaticResource NameBandAColor}"/>
    <SolidColorBrush x:Key="NameBandBrushB" Color="{StaticResource NameBandBColor}"/>
    <SolidColorBrush x:Key="AccentStripeBrushA" Color="{StaticResource AccentStripeAColor}"/>
    <SolidColorBrush x:Key="AccentStripeBrushB" Color="{StaticResource AccentStripeBColor}"/>
    <SolidColorBrush x:Key="EmployeeOutlineBrush" Color="{StaticResource EmployeeOutlineColor}"/>
    <SolidColorBrush x:Key="TaskChipTextBrush" Color="{StaticResource TaskChipTextColor}"/>
</ResourceDictionary>
