<Window x:Class="Wochenplanung.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wochenplanung.Presentation.Views"
        mc:Ignorable="d"
        Title="Meisterfenster" Height="800" Width="1400" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app_icon.png"
        Background="{DynamicResource BackgroundBrush}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddTaskCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding AddEmployeeCommand}"/>
        <KeyBinding Key="F5" Command="{Binding LoadDataCommand}"/>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopySelectedTaskCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCopiedTaskAtCurrentDateCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteTaskCommand}"/>
        <KeyBinding Key="Back" Command="{Binding DeleteTaskCommand}"/>
    </Window.InputBindings>
    <Grid>
        <views:ScheduleView DataContext="{Binding}" />
    </Grid>
</Window>
