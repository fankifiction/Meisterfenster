<Window x:Class="Wochenplanung.Presentation.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wochenplanung.Presentation.ViewModels"
        xmlns:domain="clr-namespace:Wochenplanung.Domain.Entities"
             xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
             xmlns:views="clr-namespace:Wochenplanung.Presentation.Views"
        mc:Ignorable="d"
        Title="{x:Static loc:UiText.TaskDialogTitle}" Height="680" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="20" Padding="24" Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.LabelEmployee}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <ComboBox Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                          DisplayMemberPath="DisplayName" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="2" Text="{x:Static loc:UiText.LabelDescription}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <CheckBox Grid.Row="4" Content="{x:Static loc:UiText.LabelMultiDayTask}" IsChecked="{Binding IsMultiDay}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="5" Text="{x:Static loc:UiText.LabelStartDate}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <views:ModernDatePicker Grid.Row="6" SelectedDate="{Binding StartDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="7" Text="{x:Static loc:UiText.LabelEndDate}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"
                           Visibility="{Binding IsMultiDay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <views:ModernDatePicker Grid.Row="8" SelectedDate="{Binding EndDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy" Margin="0,0,0,16"
                            Visibility="{Binding IsMultiDay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Grid.Row="9" Text="{x:Static loc:UiText.LabelStartTimeOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="10" Margin="0,0,0,16">
                    <TextBox.Text>
                        <Binding Path="StartTime" UpdateSourceTrigger="LostFocus" Converter="{StaticResource TimeSpanConverter}"/>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="11" Text="{x:Static loc:UiText.LabelEndTimeOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="12" Margin="0,0,0,16">
                    <TextBox.Text>
                        <Binding Path="EndTime" UpdateSourceTrigger="LostFocus" Converter="{StaticResource TimeSpanConverter}"/>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="13" Text="{x:Static loc:UiText.LabelLocationOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="14" Text="{Binding Location}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="15" Text="{x:Static loc:UiText.LabelProjectOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="16" Text="{Binding Project}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="17" Text="{x:Static loc:UiText.LabelTaskType}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <ComboBox Grid.Row="18" SelectedItem="{Binding TaskType}" Margin="0,0,0,16" x:Name="TaskTypeCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TaskTypeToDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="19" Text="{x:Static loc:UiText.LabelColor}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <ComboBox Grid.Row="20" SelectedItem="{Binding TaskColor}" Margin="0,0,0,16" x:Name="TaskColorCombo">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Margin="0,0,8,0"
                                           Fill="{Binding Converter={StaticResource TaskColorConverter}}"/>
                                <TextBlock Text="{Binding Converter={StaticResource TaskColorToDisplayConverter}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="21" Text="{x:Static loc:UiText.LabelNotesOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="22" Text="{Binding Notes}" TextWrapping="Wrap" AcceptsReturn="True" 
                         Height="64" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="23" Text="{Binding LastChangedText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="24" Text="{x:Static loc:UiText.LabelRecurrence}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"
                           Visibility="{Binding ShowRecurrenceEditor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ComboBox Grid.Row="25" SelectedItem="{Binding RecurrencePattern}" Margin="0,0,0,8" x:Name="RecurrenceCombo"
                          Visibility="{Binding ShowRecurrenceEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RecurrencePatternToDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Row="26" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center"
                            Visibility="{Binding ShowRecurrenceEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Static loc:UiText.LabelRepeatCount}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Width="70" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Grid.Row="24" Text="{x:Static loc:UiText.LabelSeriesScope}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"
                           Visibility="{Binding HasSeries, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ComboBox Grid.Row="25" SelectedItem="{Binding SeriesEditScope}" Margin="0,0,0,8" x:Name="SeriesScopeCombo"
                          Visibility="{Binding HasSeries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SeriesEditScopeToDisplayConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Row="27" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,24">
                    <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Padding="18,10"/>
                    <Button Content="{x:Static loc:UiText.DialogSave}" IsDefault="True" Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="18,10"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
