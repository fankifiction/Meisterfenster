<Window x:Class="Wochenplanung.Presentation.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wochenplanung.Presentation.ViewModels"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        mc:Ignorable="d"
        Title="{x:Static loc:UiText.EmployeeDialogTitle}"
        Height="500" Width="460" MinHeight="440" MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Border Padding="24" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinHeight="320">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.LabelEmployeeNumberOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="1" Text="{Binding EmployeeNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="2" Text="{x:Static loc:UiText.LabelFirstName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="3" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="4" Text="{x:Static loc:UiText.LabelLastName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="5" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="6" Text="{x:Static loc:UiText.LabelRoleOptional}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,0,0,6" FontSize="14"/>
                <TextBox Grid.Row="7" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,16" MinHeight="32"/>

                <CheckBox Grid.Row="8" Content="{x:Static loc:UiText.LabelEmployeeActive}"
                          IsChecked="{Binding IsActive}" Margin="0,0,0,24"/>

                <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Padding="18,10"/>
                    <Button Content="{x:Static loc:UiText.DialogSave}" IsDefault="True"
                            Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="18,10"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
