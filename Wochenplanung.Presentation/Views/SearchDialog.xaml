<Window x:Class="Wochenplanung.Presentation.Views.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        Title="{x:Static loc:UiText.SearchDialogTitle}"
        Height="480" Width="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{x:Static loc:UiText.SearchDialogHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="{x:Static loc:UiText.SearchButton}" Click="Search_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="16,8" IsDefault="True"/>
                <TextBox x:Name="QueryBox" FontSize="14"/>
            </DockPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="{x:Static loc:UiText.SearchJump}" Click="Jump_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"/>
        </StackPanel>
        <ListBox x:Name="ResultList" MouseDoubleClick="Jump_Click" DisplayMemberPath="Display"/>
    </DockPanel>
</Window>
