<Window x:Class="Wochenplanung.Presentation.Views.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        Title="{x:Static loc:UiText.PrintPreviewTitle}"
        Height="740" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="{x:Static loc:UiText.LabelPrinter}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="PrinterCombo" DisplayMemberPath="FullName"
                          SelectionChanged="PrinterCombo_SelectionChanged"/>

                <TextBlock Text="{x:Static loc:UiText.LabelOrientation}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,6"/>
                <ComboBox x:Name="OrientationCombo" SelectionChanged="PrintSetting_Changed"/>

                <TextBlock Text="{x:Static loc:UiText.LabelCopies}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,6"/>
                <ComboBox x:Name="CopiesCombo" SelectionChanged="PrintSetting_Changed"/>

                <TextBlock Text="{x:Static loc:UiText.LabelColorMode}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,6"/>
                <ComboBox x:Name="ColorCombo" SelectionChanged="PrintSetting_Changed"/>

                <Button Content="{x:Static loc:UiText.ActionMorePrintSettings}"
                        Margin="0,20,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,8"
                        Click="MoreSettings_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Width="120" Margin="0,0,12,0"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,10"/>
            <Button x:Name="PrintButton" Content="{x:Static loc:UiText.ActionPrint}" IsDefault="True" Width="120"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="12,10" Click="PrintButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
