<Window x:Class="Wochenplanung.Presentation.Views.HolidayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        xmlns:views="clr-namespace:Wochenplanung.Presentation.Views"
        mc:Ignorable="d"
        Title="{x:Static loc:UiText.HolidayDialogTitle}" Height="640" MinHeight="520" Width="520" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="16" Padding="20" Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="IntroText"
                      FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap"
                      Text="{x:Static loc:UiText.HolidayDialogIntro}"/>
            <TextBlock Grid.Row="1" x:Name="NameLabel"
                      FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="13"
                      Text="{x:Static loc:UiText.LabelHolidayName}"/>
            <TextBox Grid.Row="2" Text="{Binding HolidayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
            <CheckBox Grid.Row="3" Content="{x:Static loc:UiText.LabelHolidayRange}" IsChecked="{Binding IsRange}" Margin="0,0,0,8"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:UiText.LabelFrom}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <views:ModernDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Compact="True"
                                            DisplayFormat="dd.MM.yyyy" MinWidth="168"/>
                </StackPanel>
                <StackPanel Margin="20,0,0,0" Visibility="{Binding IsRange, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Static loc:UiText.LabelTo}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <views:ModernDatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Compact="True"
                                            DisplayFormat="dd.MM.yyyy" MinWidth="168"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,0,0,8" Visibility="{Binding ShowSwissHolidays, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Static loc:UiText.LabelSwissHolidays}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{x:Static loc:UiText.SwissHolidaysHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{x:Static loc:UiText.LabelYear}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Width="90" ItemsSource="{Binding SwissYearOptions}" SelectedItem="{Binding SwissYear}"/>
                    <Button Content="{x:Static loc:UiText.ActionSwissFederal}" Command="{Binding SelectFederalOnlyCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,8,0" Padding="10,6"/>
                    <Button Content="{x:Static loc:UiText.ActionSwissSolothurn}" Command="{Binding SelectSolothurnCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="10,6"/>
                    <Button Content="{x:Static loc:UiText.ActionSwissAll}" Command="{Binding SelectAllSwissCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,6"/>
                </StackPanel>
            </StackPanel>
            <ListBox Grid.Row="6" ItemsSource="{Binding SwissHolidays}" BorderThickness="1"
                     BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,12"
                     Visibility="{Binding ShowSwissHolidays, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Width="100" Margin="0,0,12,0" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10"/>
                <Button Content="{x:Static loc:UiText.ActionApply}" IsDefault="True" Width="100" Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="12,10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
