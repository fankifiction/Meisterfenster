<Window x:Class="Wochenplanung.Presentation.Views.ExportRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        xmlns:views="clr-namespace:Wochenplanung.Presentation.Views"
        mc:Ignorable="d"
        Title="{x:Static loc:UiText.ExportRangeDialogTitle}"
        Height="460" Width="420" MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="16" Padding="20" Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.ExportRangeIntro}" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,16"/>
            <TextBlock Grid.Row="1" Text="{x:Static loc:UiText.LabelFrom}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <views:ModernDatePicker Grid.Row="2" SelectedDate="{Binding StartDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy" Margin="0,0,0,14"/>
            <TextBlock Grid.Row="3" Text="{x:Static loc:UiText.LabelTo}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <views:ModernDatePicker Grid.Row="4" SelectedDate="{Binding EndDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="5" Text="{x:Static loc:UiText.LabelExportFontSize}"
                      FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <Slider Minimum="9" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding FontSize}" Width="220"/>
                <TextBlock Text="{Binding FontSize, StringFormat='{}{0} pt'}" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Grid.Row="7" Text="{x:Static loc:UiText.ExportRangeHint}"
                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"
                      Margin="0,0,0,20" Opacity="0.85"/>
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Width="100" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10"/>
                <Button Content="{x:Static loc:UiText.ActionExport}" IsDefault="True" Width="100" Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="12,10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
