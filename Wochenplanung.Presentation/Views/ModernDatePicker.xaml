<UserControl x:Class="Wochenplanung.Presentation.Views.ModernDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="168">
    <UserControl.Resources>
        <Style x:Key="DateChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="OpenButton"
                Click="OpenButton_Click"
                Style="{StaticResource DateChipButtonStyle}"
                ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                      Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.9 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z"
                      Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DisplayText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Path Width="10" Height="6" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                      Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                      Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=OpenButton}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="CalendarPopup_Closed">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10">
                <Border.Resources>
                    <Style TargetType="primitives:CalendarItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="primitives:CalendarDayButton">
                        <Setter Property="Width" Value="34"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="primitives:CalendarDayButton">
                                    <Border x:Name="Bd"
                                            CornerRadius="8"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            Margin="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsToday" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsInactive" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="primitives:CalendarButton">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="primitives:CalendarButton">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.28" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Calendar x:Name="InnerCalendar"
                              SelectedDatesChanged="InnerCalendar_SelectedDatesChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button x:Name="TodayButton"
                            Click="TodayButton_Click"
                            Margin="4,8,4,2"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
