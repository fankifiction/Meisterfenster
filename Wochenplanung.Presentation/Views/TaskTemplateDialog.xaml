<Window x:Class="Wochenplanung.Presentation.Views.TaskTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wochenplanung.Presentation.ViewModels"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        mc:Ignorable="d"
        Title="{x:Static loc:UiText.TaskTemplateDialogTitle}"
        Height="440" Width="420" MinHeight="400" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="16" Padding="20" Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.LabelDescription}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
            <TextBox Grid.Row="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="2" Text="{x:Static loc:UiText.LabelTaskType}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
            <ComboBox x:Name="TaskTypeCombo" Grid.Row="3" SelectedItem="{Binding TaskType}" Margin="0,0,0,14" MinHeight="28">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource TaskTypeToDisplayConverter}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="4" Text="{x:Static loc:UiText.LabelColor}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" FontSize="14"/>
            <ComboBox x:Name="TaskColorCombo" Grid.Row="5" SelectedItem="{Binding TaskColor}" Margin="0,0,0,20" MinHeight="28">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource TaskColorToDisplayConverter}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Width="100" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10"/>
                <Button Content="{x:Static loc:UiText.DialogSave}" IsDefault="True" Command="{Binding SaveCommand}" Width="100"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
