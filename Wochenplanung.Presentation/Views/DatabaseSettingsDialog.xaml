<Window x:Class="Wochenplanung.Presentation.Views.DatabaseSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Wochenplanung.Presentation.Converters"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        Title="{x:Static loc:UiText.DatabaseDialogTitle}"
        Height="620" Width="520" MinHeight="520" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <Border Padding="24" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{x:Static loc:UiText.DatabaseDialogIntro}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <RadioButton Content="{x:Static loc:UiText.DatabaseModeLocal}"
                             IsChecked="{Binding IsLocalMode, Mode=TwoWay}" Margin="0,0,0,8"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                <RadioButton Content="{x:Static loc:UiText.DatabaseModeServer}"
                             IsChecked="{Binding IsServerMode, Mode=TwoWay}" Margin="0,0,0,16"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>

                <StackPanel IsEnabled="{Binding IsServerMode}">
                    <TextBlock Text="{x:Static loc:UiText.LabelDatabaseServer}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="{x:Static loc:UiText.LabelDatabaseName}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <CheckBox Content="{x:Static loc:UiText.LabelWindowsAuth}"
                              IsChecked="{Binding UseWindowsAuthentication}"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <StackPanel Visibility="{Binding ShowSqlLogin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Static loc:UiText.LabelSqlUser}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="{x:Static loc:UiText.LabelSqlPassword}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"/>
                        <TextBlock Text="{x:Static loc:UiText.DatabasePasswordHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
                    </StackPanel>
                </StackPanel>

                <CheckBox Content="{x:Static loc:UiText.LabelCopyLocalData}"
                          IsChecked="{Binding CopyLocalData}"
                          Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,8,0,12"/>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static loc:UiText.ActionTestConnection}"
                            Command="{Binding TestConnectionCommand}"
                            Click="TestButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="14,8"/>
                    <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                    <Button Content="{x:Static loc:UiText.DialogSave}" IsDefault="True"
                            Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
