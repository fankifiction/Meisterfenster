<Window x:Class="Wochenplanung.Presentation.Views.ImportMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        Title="{x:Static loc:UiText.ImportMappingDialogTitle}"
        Height="420" Width="520" MinHeight="380" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="16" Padding="20" Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.ImportMappingIntro}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="{Binding RowCountText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="2" Text="{x:Static loc:UiText.LabelEmployeeColumn}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox Grid.Row="3" ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding EmployeeColumn}" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="4" Text="{x:Static loc:UiText.LabelDateColumn}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox Grid.Row="5" ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding DateColumn}" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="6" Text="{x:Static loc:UiText.LabelDescriptionColumn}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox Grid.Row="7" ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding DescriptionColumn}" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{x:Static loc:UiText.DialogCancel}" IsCancel="True" Width="110" Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="{x:Static loc:UiText.ActionStartImport}" IsDefault="True" Width="130" Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
