<Window x:Class="Wochenplanung.Presentation.Views.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="460" MinWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DangerIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FDECEC"/>
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#F2B8B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FAD3D1"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E87E79"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F3B1AD"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D65A55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        Margin="12,0,0,0"
                        Style="{StaticResource DangerIconButtonStyle}"
                        Content="&#x00D7;">
                </Button>
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,14,0,16" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       MaxWidth="560" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoButton" Content="{x:Static loc:UiText.MsgNo}" Width="100" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="No_Click" Visibility="Collapsed"/>
                <Button x:Name="CancelButton" Content="{x:Static loc:UiText.DialogCancel}" Width="100" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Visibility="Collapsed"/>
                <Button x:Name="OkButton" Content="{x:Static loc:UiText.MsgOk}" Width="100" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
