<Window x:Class="Wochenplanung.Presentation.Views.StatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        xmlns:views="clr-namespace:Wochenplanung.Presentation.Views"
        Title="{x:Static loc:UiText.StatisticsDialogTitle}" Height="460" Width="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="16" Padding="16" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.StatisticsIntro}"
                      FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{x:Static loc:UiText.LabelFrom}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <views:ModernDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy"/>
                <TextBlock Text="{x:Static loc:UiText.LabelTo}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <views:ModernDatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy"/>
            </StackPanel>
            <Button Grid.Row="2" Content="{x:Static loc:UiText.ActionRefreshStatistics}" Click="Refresh_Click" Margin="0,0,0,12" Style="{StaticResource SecondaryButtonStyle}"/>
            <DataGrid x:Name="StatsGrid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:UiText.ColEmployee}" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="{x:Static loc:UiText.ColDays}" Binding="{Binding TaskDays}" Width="80"/>
                    <DataGridTextColumn Header="{x:Static loc:UiText.ColHoursApprox}" Binding="{Binding TaskHours, StringFormat=N1}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="4" Content="{x:Static loc:UiText.DialogClose}" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>
    </Border>
</Window>
