<Window x:Class="Wochenplanung.Presentation.Views.AbsenceReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wochenplanung.Presentation.Localization"
        xmlns:views="clr-namespace:Wochenplanung.Presentation.Views"
        Title="{x:Static loc:UiText.AbsenceDialogTitle}" Height="540" Width="680" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="16" Padding="16" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{x:Static loc:UiText.AbsenceIntro}"
                      FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{x:Static loc:UiText.LabelEmployee}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="240" ItemsSource="{Binding EmployeeOptions}" SelectedItem="{Binding SelectedEmployeeOption}"
                          DisplayMemberPath="Name"/>
                <TextBlock Text="{x:Static loc:UiText.LabelYear}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox Width="90" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}"
                          IsEnabled="{Binding UseYearMode}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="{x:Static loc:UiText.LabelRangeMode}" IsChecked="{Binding UseCustomRange}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="{x:Static loc:UiText.LabelFrom}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <views:ModernDatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy"
                                        Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{x:Static loc:UiText.LabelTo}" VerticalAlignment="Center" Margin="16,0,8,0"
                           Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <views:ModernDatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Compact="True" DisplayFormat="dd.MM.yyyy"
                                        Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
            <Button Grid.Row="3" Content="{x:Static loc:UiText.ActionRefresh}" Click="Refresh_Click" Margin="0,0,0,12" Style="{StaticResource SecondaryButtonStyle}"/>
            <DataGrid x:Name="ReportGrid" Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:UiText.ColEmployee}" Binding="{Binding EmployeeName}" Width="140"/>
                    <DataGridTextColumn Header="{x:Static loc:UiText.ColDate}" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="{x:Static loc:UiText.ColType}" Binding="{Binding TypeDisplay}" Width="110"/>
                    <DataGridTextColumn Header="{x:Static loc:UiText.LabelDescription}" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="5">
                <TextBlock Text="{Binding TotalText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Content="{x:Static loc:UiText.DialogClose}" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
