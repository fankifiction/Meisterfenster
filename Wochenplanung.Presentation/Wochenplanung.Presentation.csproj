<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wochenplanung.Application\Wochenplanung.Application.csproj" />
    <ProjectReference Include="..\Wochenplanung.Infrastructure\Wochenplanung.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>$(MeisterfensterVersion)</Version>
    <AssemblyVersion>$(MeisterfensterVersion).0</AssemblyVersion>
    <FileVersion>$(MeisterfensterVersion).0</FileVersion>
    <Product>Meisterfenster</Product>
    <Description>Wochenplanung für Mitarbeiter</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app_icon.png" />
    <EmbeddedResource Include="Localization\strings.json" />
    <None Include="..\installer\Meisterfenster-Starten.bat" Link="Meisterfenster-Starten.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
